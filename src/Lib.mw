-- Fuzzy: finding the things a few typed letters mean.
--
--   use Fuzzy (rank, found, score, places)
--
--   rank "vlen" (\d -> d) ["Vector.length", "valueOf", "String.length"]
--   -- [("Vector.length", …), …] -- best first; "valueOf" has no `n`, and is not there
--
-- A query matches a text when its letters are in the text, in order, with
-- anything between them: `vlen` is in `Vector.length`. What a picker wants is
-- the texts a query matches, the likeliest first, and where in each the
-- letters fell, to show them. So a match has a **score**, and of all the ways
-- a query's letters can be found in a text, the one found is the one that
-- scores highest:
--
-- - a letter at the **start of a word** counts for more -- the first letter,
--   one after a `.`, `_`, `/`, `-` or a space, and a capital after a small
--   letter, so `vl` finds `Vector.length` and `gT` finds `getText`;
-- - letters **next to each other** count for more than the same letters
--   apart, and each letter skipped between two costs a little;
-- - nothing else: a shorter text is not a better one, though of two that
--   score the same `rank` puts the shorter first.
--
-- A query is **several words** when it has spaces in it: each has to be in
-- the text, anywhere, and the score is the sum. `vec len` finds
-- `Std.Collections.Vector.length`, and so does `len vec`.
--
-- **Case.** A query in small letters matches either case. A capital in the
-- query matches only a capital -- so typing one is asking for it.
--
-- Letters are characters, not bytes, and a place is a character's index in
-- the text: `places` are what to highlight.

use Std.Collections.Vector as V
use Std.String as S
use Std.Char as C
use Std.Maybe.Maybe.*
use Std.Sort (sortBy)
use Std.Ordering.Ordering.*

-- A query found in a text: how well, and which characters of the text its
-- letters are, in order.
@derive(Debug, PartialEq)
@pub data Found = Found Int [Int]

@pub fun score (f : Found) : Int = match f with | Found s _ -> s

@pub fun places (f : Found) : [Int] = match f with | Found _ ps -> ps

-- What a letter matched is worth; more at the start of a word, or the text;
-- more again right after the letter before; and what skipping costs -- the
-- first character skipped, and each after it.
def matched : Int = 16
def atWordStart : Int = 8
def atCamel : Int = 7
def atTextStart : Int = 8
def adjacent : Int = 6
def gapOpens : Int = 3
def gapGoesOn : Int = 1

-- So low that nothing adds up to it: no way to get here.
def never : Int = 0 - 1000000

-- `query` in `text`, as well as it can be found -- every word of it, when it
-- is several -- or `None` when it is not there. An empty query is found in
-- anything, for nothing.
@pub fun found (query : String) (text : String) : Maybe Found =
  let words = V.filter (\w -> not (S.isEmpty w)) (S.split " " query) in
  let cs = V.toArray (S.chars text) in
  V.foldl
    (\acc w ->
      match acc with
      | None -> None
      | Just (Found total ps) ->
          (match foundWord (V.toArray (S.chars w)) cs with
           | Just (Found s qs) -> Just (Found (total + s) (merged ps qs))
           | None -> None))
    (Just (Found 0 []))
    words

-- Two lists of places, each in order, as one.
fun merged (xs : [Int]) (ys : [Int]) : [Int] = mergeFrom xs ys 0 0 []

fun mergeFrom (xs : [Int]) (ys : [Int]) (i : Int) (j : Int) (out : [Int]) : [Int] =
  match (V.get xs i, V.get ys j) with
  | (None, None) -> out
  | (Just x, None) -> mergeFrom xs ys (i + 1) j (V.pushBack out x)
  | (None, Just y) -> mergeFrom xs ys i (j + 1) (V.pushBack out y)
  | (Just x, Just y) ->
      if x < y then mergeFrom xs ys (i + 1) j (V.pushBack out x)
      else if y < x then mergeFrom xs ys i (j + 1) (V.pushBack out y)
      else mergeFrom xs ys (i + 1) (j + 1) (V.pushBack out x)

-- Whether query letter `q` is text letter `t`: a small letter is either case.
fun same (q : Char) (t : Char) : Bool = q == t or (C.isLower q and C.toLower t == q)

-- Whether the letters of `q` are in `t` in order at all: what most texts are
-- told apart by, before anything is scored.
fun within (q : #[Char]) (t : #[Char]) (i : Int) (j : Int) : Bool =
  if i >= arrayLen q then True
  else if j >= arrayLen t then False
  else if same (arrayGet q i) (arrayGet t j) then within q t (i + 1) (j + 1)
  else within q t i (j + 1)

-- What matching at character `j` of `t` adds for where it is.
fun bonus (t : #[Char]) (j : Int) : Int =
  if j == 0 then atWordStart + atTextStart
  else
    let before = arrayGet t (j - 1) in
    let here = arrayGet t j in
    if not (C.isAlphaNum before) and C.code before < 128 then atWordStart
    else if C.isLower before and C.isUpper here then atCamel
    else 0

-- One word of a query in a text. A table, a row a letter of the word and a
-- column a character of the text: the best score of the word up to that
-- letter with the letter at that character, and whether it got there from
-- the character before or from further back. The last row's best is the
-- answer, and the way back up from it is where the letters are.
fun foundWord (q : #[Char]) (t : #[Char]) : Maybe Found =
  let m = arrayLen q in
  let n = arrayLen t in
  if m == 0 then Just (Found 0 [])
  else if not (within q t 0 0) then None
  else
    runSt (\() ->
      let best = stNewArray (m * n) never in
      -- Where the letter before was, for each cell: -1 for the first letter.
      let from = stNewArray (m * n) (0 - 1) in
      let u = fillRows q t m n best from 0 in
      let last = bestIn best ((m - 1) * n) n 0 (0 - 1) never in
      if last < 0 then None
      else Just (Found (stGetArray best ((m - 1) * n + last)) (wayBack from n (m - 1) last [])))

fun fillRows q t (m : Int) (n : Int) best from (i : Int) =
  if i >= m then ()
  else (let u = fillRow q t n best from i 0 never (0 - 1) in fillRows q t m n best from (i + 1))

-- Row `i`, from column `j` on. `gapped` is the best the letter before can do
-- from a character at least two back, what is skipped since paid for, and
-- `gappedAt` where that was.
fun fillRow q t (n : Int) best from (i : Int) (j : Int) (gapped : Int) (gappedAt : Int) =
  if j >= n then ()
  else
    -- The letter before at the character just before this one is one step
    -- from being a gap for the next column.
    let prior = if i > 0 and j > 0 then stGetArray best ((i - 1) * n + j - 1) else never in
    let u =
      (if not (same (arrayGet q i) (arrayGet t j)) then ()
       else if i == 0 then stSetArray best j (matched + bonus t j)
       else
         let next = if prior > never then prior + adjacent else never in
         let apart = if gapped > never then gapped else never in
         if next <= never and apart <= never then ()
         else if next >= apart then
           (let a = stSetArray best (i * n + j) (next + matched + bonus t j) in stSetArray from (i * n + j) (j - 1))
         else
           (let a = stSetArray best (i * n + j) (apart + matched + bonus t j) in stSetArray from (i * n + j) gappedAt)) in
    -- For the next column: every way so far is one more character apart, and
    -- the one just before this column opens a gap.
    let older = if gapped > never then gapped - gapGoesOn else never in
    let opened = if prior > never then prior - gapOpens else never in
    if opened > older then fillRow q t n best from i (j + 1) opened (j - 1)
    else fillRow q t n best from i (j + 1) older gappedAt

-- The column of the best score in the row that starts at `row`.
fun bestIn best (row : Int) (n : Int) (j : Int) (at : Int) (top : Int) =
  if j >= n then at
  else
    let s = stGetArray best (row + j) in
    if s > top then bestIn best row n (j + 1) j s else bestIn best row n (j + 1) at top

fun wayBack from (n : Int) (i : Int) (j : Int) (out : [Int]) =
  if i < 0 or j < 0 then out
  else wayBack from n (i - 1) (stGetArray from (i * n + j)) (V.pushFront out j)

-- The items `query` is found in, by `text` of each, best first: of two found
-- as well, the shorter text, and then the one that came first.
@pub fun rank (query : String) (text : a -> String) (items : [a]) : [(a, Found)] =
  let hits =
    V.concatMap
      (\i -> match V.get items i with
             | Just x -> (let t = text x in match found query t with | Just f -> [(x, f, S.charLength t, i)] | None -> [])
             | None -> [])
      (V.range 0 (V.len items)) in
  let order = \a b ->
    match (a, b) with
    | ((_, f, la, ia), (_, g, lb, ib)) ->
        if score f != score g then compare (score g) (score f)
        else if la != lb then compare la lb
        else compare ia ib in
    V.map (\h -> match h with | (x, f, _, _) -> (x, f)) (sortBy order hits)

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)
use Std.Maybe as M

fun placed (q : String) (t : String) : Maybe [Int] = M.map places (found q t)

fun first (q : String) (ts : [String]) : [String] = V.map fst (rank q (\t -> t) ts)

@test fun lettersAreFoundInOrderWithAnythingBetween () =
  let a = assertEq (placed "vlen" "Vector.length") (Just [0, 7, 8, 9]) "the V, and `len` after the dot" in
  let b = assertEq (placed "abc" "a-b-c") (Just [0, 2, 4]) "each where it is" in
  let c = assertEq (placed "ba" "abc") None "not out of order" in
  assertEq (placed "x" "abc") None "and not when a letter is missing"

@test fun anEmptyQueryIsFoundInAnything () =
  let a = assertEq (found "" "anything") (Just (Found 0 [])) "for nothing" in
  assertEq (found "   " "") (Just (Found 0 [])) "spaces are no words"

@test fun theStartOfAWordIsWorthMoreThanItsMiddle () =
  -- `len` is in both; in the second it starts a word.
  let a = assertEq (first "len" ["silently", "Vector.length"]) ["Vector.length", "silently"] "after the dot first" in
  -- A capital after a small letter starts a word too.
  let b = assertEq (placed "gt" "getText") (Just [0, 3]) "the T of Text, not the t of get" in
  assertEq (first "fb" ["affable", "fooBar"]) ["fooBar", "affable"] "the B that starts a word, before the b in one"

@test fun lettersTogetherAreWorthMoreThanLettersApart () =
  let a = assertEq (first "map" ["xmxaxp", "amap", "mapping"]) ["mapping", "amap", "xmxaxp"] "whole at the start; whole; apart" in
  assertEq (placed "ab" "xaxbab") (Just [4, 5]) "the two that are side by side"

@test fun aCapitalAsksForACapital () =
  let a = assertEq (placed "v" "aVector") (Just [1]) "a small letter finds a capital at a word's start" in
  let b = assertEq (placed "V" "valueVector") (Just [5]) "a capital finds only a capital" in
  assertEq (placed "V" "value") None "and none is no match"

@test fun everyWordOfAQueryHasToBeThere () =
  let a = assertEq (first "vec len" ["String.length", "Std.Collections.Vector.length", "Vector.map"]) ["Std.Collections.Vector.length"] "both words" in
  let b = assertEq (M.map places (found "len vec" "Vector.length")) (Just [0, 1, 2, 7, 8, 9]) "in either order, the places in the text's" in
  assertEq (M.isSome (found "vec zzz" "Vector.length")) False "one word missing is no match"

@test fun ofTwoFoundAsWellTheShorterIsFirstThenTheEarlier () =
  let a = assertEq (first "ab" ["abcd", "ab", "abc"]) ["ab", "abc", "abcd"] "shorter first" in
  assertEq (first "a" ["ax", "ay"]) ["ax", "ay"] "then as they came"

@test fun lettersAreCharactersNotBytes () =
  assertEq (placed "é" "caf\u{e9}") (Just [3]) "the fourth character, though it starts at the fourth byte and is two"
